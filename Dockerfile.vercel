FROM sreedockerhub19/micronaut-java:latest

ENV PORT=80
EXPOSE $PORT

# Force the PATH just in case it was stripped
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Use the absolute path to the Java binary (/opt/java/openjdk/bin/java)
ENTRYPOINT ["sh", "-c", "/opt/java/openjdk/bin/java -Dserver.port=$PORT -Dmicronaut.server.port=$PORT -jar app.jar"]