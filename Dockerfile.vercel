# Pull your already-built image from Docker Hub
FROM sreedockerhub19/micronaut-java:latest

# Set a fallback port and expose Vercel's dynamic $PORT
ENV PORT=80
EXPOSE $PORT

# Start the app, injecting the $PORT variable.
# (Added both standard and Micronaut-specific port properties to ensure it binds correctly)
CMD ["sh", "-c", "java -Dserver.port=$PORT -Dmicronaut.server.port=$PORT -jar app.jar"]